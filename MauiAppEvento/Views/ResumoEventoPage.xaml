<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEvento.Views.ResumoEventoPage"
             Title="Resumo do Evento">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Border StrokeShape="RoundRectangle 10" Padding="20">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Resumo do Evento" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <BoxView HeightRequest="1" Color="Gray" Margin="0,5" />

                    <Label Text="{Binding Nome}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" FontSize="15" />

                    <Label Text="{Binding DataInicio, StringFormat='Data de Início: {0:dd/MM/yyyy}'}" FontSize="15" />
                    <Label Text="{Binding DataTermino, StringFormat='Data de Término: {0:dd/MM/yyyy}'}" FontSize="15" />
                    <Label Text="{Binding DuracaoEmDias, StringFormat='Duração: {0} dia(s)'}" 
                           FontSize="15" 
                           FontAttributes="Bold" />

                    <Label Text="{Binding QntParticipantes, StringFormat='Número de Participantes: {0}'}" FontSize="15" />
                    <Label Text="{Binding CustoParticipante, StringFormat='Custo por Participante: {0:C}'}" FontSize="15" />

                    <BoxView HeightRequest="1" Color="Gray" Margin="0,5" />

                    <Label Text="{Binding CustoTotal, StringFormat='Custo Total do Evento: {0:C}'}" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="DarkGreen" 
                           HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar" 
                    Clicked="Button_Voltar_Clicked" 
                    CornerRadius="8" 
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>